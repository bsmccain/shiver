<section class="doom-clock {{#if midnight}}midnight{{/if}}">
  <svg class="doom-dial" viewBox="0 0 120 120" role="img" aria-label="{{minutes}} / 60">
    <circle class="face" cx="{{cx}}" cy="{{cy}}" r="{{r}}"></circle>
    {{#if wedge}}<path class="fill" d="{{wedge}}"></path>{{/if}}
    {{#each ticks}}
    <line class="tick {{#if major}}major{{/if}} {{#if passed}}passed{{/if}}" x1="{{x1}}" y1="{{y1}}" x2="{{x2}}" y2="{{y2}}"></line>
    {{/each}}
    <line class="hand" x1="{{cx}}" y1="{{cy}}" x2="{{hand.x}}" y2="{{hand.y}}"></line>
    <circle class="hub" cx="{{cx}}" cy="{{cy}}" r="4"></circle>
    <text class="mark" x="60" y="26" text-anchor="middle">60</text>
    <text class="mark" x="96" y="64" text-anchor="middle">15</text>
    <text class="mark" x="60" y="101" text-anchor="middle">30</text>
    <text class="mark" x="24" y="64" text-anchor="middle">45</text>
  </svg>
  <div class="doom-readout">
    <div class="doom-minutes" data-minutes="{{minutes}}"><strong>{{minutes}}</strong> / 60 {{localize "shiver.Doom.min"}}</div>
    <div class="doom-label">{{label}}</div>
    <div class="doom-meta">{{localize "shiver.Doom.cycle"}} {{cycle}} · {{quarterLabel}}</div>
    {{#if toNext}}<div class="doom-next">{{toNext}} {{localize "shiver.Doom.minTo"}} {{nextLabel}}</div>{{/if}}
  </div>
  {{#if isGM}}
  <div class="doom-controls">
    <button type="button" data-action="tick" data-delta="-1" data-tooltip="shiver.Doom.back1"><i class="fa-solid fa-minus"></i></button>
    <button type="button" data-action="tick" data-delta="1" data-tooltip="shiver.Doom.forward1"><i class="fa-solid fa-plus"></i></button>
    <button type="button" data-action="tick" data-delta="5" data-tooltip="shiver.Doom.forward5">+5</button>
    <button type="button" data-action="setMinutes" data-tooltip="shiver.Doom.setTitle"><i class="fa-solid fa-pen"></i></button>
    <button type="button" data-action="editEvents" data-tooltip="shiver.Doom.eventsTitle"><i class="fa-solid fa-skull"></i></button>
    <button type="button" data-action="newCycle" data-tooltip="shiver.Doom.newCycleTitle"><i class="fa-solid fa-clock-rotate-left"></i></button>
  </div>
  <div class="doom-tools">
    <button type="button" data-action="tool" data-tool="requestCheck" data-tooltip="shiver.Tools.requestCheck"><i class="fa-solid fa-dice"></i></button>
    <button type="button" data-action="tool" data-tool="opposedCheck" data-tooltip="shiver.Tools.opposedCheck"><i class="fa-solid fa-people-arrows"></i></button>
    <button type="button" data-action="tool" data-tool="groupCheck" data-tooltip="shiver.Tools.groupCheck"><i class="fa-solid fa-people-group"></i></button>
    <button type="button" data-action="tool" data-tool="awardLevel" data-tooltip="shiver.Tools.awardLevel"><i class="fa-solid fa-arrow-up"></i></button>
    <button type="button" data-action="tool" data-tool="damageHeal" data-tooltip="shiver.Tools.damageHeal"><i class="fa-solid fa-burst"></i></button>
    <button type="button" data-action="tool" data-tool="actOfGod" data-tooltip="shiver.Tools.actOfGod"><i class="fa-solid fa-cloud-bolt"></i></button>
  </div>
  {{/if}}
</section>
